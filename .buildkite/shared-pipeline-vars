#!/bin/sh

# This file is `source`'d before calling `buildkite-agent pipeline upload`, and can be used
# to set up some variables that will be interpolated in the `.yml` pipeline before uploading it.

# The ~> modifier is not currently used, but we check for it just in case
XCODE_VERSION=$(sed -E 's/^~> ?//' .xcode-version)
CI_TOOLKIT_PLUGIN_VERSION="7.1.0"
TEST_COLLECTOR_PLUGIN_VERSION="1.11.0"
DOCKER_PLUGIN_VERSION="5.13.0"
# This is also the Ruby image tag, so a `.ruby-version` bump can only land once that tag is published on ECR Public.
RUBY_VERSION=$(cat .ruby-version)

export IMAGE_ID="xcode-$XCODE_VERSION"
# The slim image is enough for those steps that only Ruby, its stock gems, and bash.
export DOCKER_RUBY_IMAGE="public.ecr.aws/docker/library/ruby:${RUBY_VERSION}-slim"
# The full image has the compiler that `bundle install` needs to build native gems.
export DOCKER_RUBY_FULL_IMAGE="public.ecr.aws/docker/library/ruby:${RUBY_VERSION}"
export CI_TOOLKIT_PLUGIN="automattic/a8c-ci-toolkit#$CI_TOOLKIT_PLUGIN_VERSION"
export DOCKER_PLUGIN="docker#v$DOCKER_PLUGIN_VERSION"
export TEST_COLLECTOR="test-collector#v$TEST_COLLECTOR_PLUGIN_VERSION"
export CLAUDE_PLUGIN="iangmaia/claude-summarize#ce99c67dd57cdf236c3daca82b86a335fd5e9cc2"
