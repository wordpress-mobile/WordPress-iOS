      "dashboard_card_pages": true,
      "jp_removal_one": true,
      "jp_removal_two": true,
      "jp_removal_three": true,
      "jp_removal_four": false,
      "jp_removal_static_posters": true,
      "jp_removal_new_users": false,
      "jp_removal_self_hosted": true,
      "stats_traffic_subscribers_tabs": true,
      "wordpress_ios_reader": false
    }
  }
}
